# Copy to .env  (cp .env.example .env). NEVER commit .env.
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Secrets: generate fresh values for anything that isn't your laptop -------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0123456789abcdef0123
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=xY3v0J6m1dU6Qm0uVZr1o7mJ0pS9x3c2HkzPqM8nE1Q=

# --- Business knobs ---------------------------------------------------------------------
PLATFORM_FEE_FLAT_INR=30
PLATFORM_TAKE_RATE_PCT=0
KYC_L2_EARNINGS_CAP_INR=50000
AUDIO_MAX_SECONDS=120

# --- Providers: mock by default; switch one at a time when you have keys ---------------
PAYMENT_PROVIDER=mock          # razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TRANSLATION_PROVIDER=mock      # bhashini | google
SPEECH_PROVIDER=mock           # bhashini | google
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
